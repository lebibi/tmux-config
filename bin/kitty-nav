#!/bin/sh
# Write kitty escape codes to a tmux client tty, which reaches kitty over ssh
#
#   kitty-nav action TTY ACTION [ARGS...]
#   kitty-nav move TTY left|right|up|down
#   kitty-nav var TTY NAME [VALUE]    empty VALUE unsets
#   kitty-nav cwd TTY PATH
set -e

cmd=$1
tty=$2
shift 2
# client_tty is empty for hooks fired outside a client
[ -n "$tty" ] && [ -w "$tty" ] || exit 0

case "$cmd" in
action)
    action=$(printf %s "$*" | sed 's/[\\"]/\\&/g')
    printf '\033P@kitty-cmd{"cmd":"action","version":[0,47,0],"no_response":true,"payload":{"action":"%s","self":true}}\033\\' "$action" >"$tty"
    ;;
move)
    case "$1" in
    up) dir=top ;;
    down) dir=bottom ;;
    *) dir=$1 ;;
    esac
    exec "$0" action "$tty" neighboring_window "$dir"
    ;;
var)
    if [ -n "$2" ]; then
        printf '\033]1337;SetUserVar=%s=%s\007' "$1" "$(printf %s "$2" | base64)" >"$tty"
    else
        printf '\033]1337;SetUserVar=%s\007' "$1" >"$tty"
    fi
    ;;
cwd)
    printf '\033]7;kitty-shell-cwd://%s%s\007' "$(hostname)" "$1" >"$tty"
    ;;
esac
