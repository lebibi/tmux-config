#!/bin/sh
# Send kitty escape codes through tmux passthrough, by writing to a pane tty
#
# tmux forwards \ePtmux;...\e\\ from a visible pane to its clients, with every
# ESC inside doubled. Needs allow-passthrough on.
#
#   kitty-nav action PANE_TTY ACTION [ARGS...]
#   kitty-nav move PANE_TTY left|right|up|down
#   kitty-nav var PANE_TTY NAME [VALUE]    empty VALUE unsets
#   kitty-nav cwd PANE_TTY PATH
set -e

cmd=$1
tty=$2
shift 2
# pane_tty is empty for hooks fired outside a client
[ -n "$tty" ] && [ -w "$tty" ] || exit 0

case "$cmd" in
action)
    action=$(printf %s "$*" | sed 's/[\\"]/\\&/g')
    printf '\033Ptmux;\033\033P@kitty-cmd{"cmd":"action","version":[0,47,0],"no_response":true,"payload":{"action":"%s","self":true}}\033\033\\\033\\' "$action" >"$tty"
    ;;
move)
    case "$1" in
    up) dir=top ;;
    down) dir=bottom ;;
    *) dir=$1 ;;
    esac
    exec "$0" action "$tty" neighboring_window "$dir"
    ;;
var)
    if [ -n "$2" ]; then
        printf '\033Ptmux;\033\033]1337;SetUserVar=%s=%s\007\033\\' "$1" "$(printf %s "$2" | base64)" >"$tty"
    else
        printf '\033Ptmux;\033\033]1337;SetUserVar=%s\007\033\\' "$1" >"$tty"
    fi
    ;;
cwd)
    printf '\033Ptmux;\033\033]7;kitty-shell-cwd://%s%s\007\033\\' "$(hostname)" "$1" >"$tty"
    ;;
esac
